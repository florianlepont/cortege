+++ b/mobile/src/diag/dmh-timing.ts
@@ -0,0 +1,76 @@
+/**
+ * Phase 32 (plan 32-07, D-08): THROWAWAY measuring aid for the entry time of factor F. It lives in
+ * the patch 32-dmh-timing-diag.patch only, is applied for the timing builds and never merged
+ * (literal strings would break the structure gate).
+ *
+ * Counts, while the F page is the active page: the seconds from the first touch to the last change
+ * of F, every finger contact (touches, a scroll gesture starts with one), the vertical scroll
+ * gestures and the corrections (a count that goes down or a group unticked).
+ */
+import { Alert } from "react-native"
+
+export type DmhTimingChange = "up" | "down" | "tick" | "untick"
+
+export type DmhTimingReport = {
+  seconds: number
+  touches: number
+  scrolls: number
+  corrections: number
+}
+
+let active = false
+let startedAt: number | null = null
+let lastChangeAt: number | null = null
+let touches = 0
+let scrolls = 0
+let corrections = 0
+
+export function dmhTimingReset(): void {
+  startedAt = null
+  lastChangeAt = null
+  touches = 0
+  scrolls = 0
+  corrections = 0
+}
+
+/** The pager tells whether the F page is the one on screen; nothing is counted otherwise. */
+export function dmhTimingSetActive(next: boolean): void {
+  active = next
+}
+
+export function dmhTimingTouch(): void {
+  if (!active) return
+  if (startedAt === null) startedAt = Date.now()
+  touches += 1
+}
+
+export function dmhTimingScroll(): void {
+  if (!active) return
+  scrolls += 1
+}
+
+export function dmhTimingChange(kind: DmhTimingChange): void {
+  if (!active || startedAt === null) return
+  lastChangeAt = Date.now()
+  if (kind === "down" || kind === "untick") corrections += 1
+}
+
+export function dmhTimingReport(): DmhTimingReport {
+  const seconds =
+    startedAt !== null && lastChangeAt !== null
+      ? Math.round(((lastChangeAt - startedAt) / 1000) * 10) / 10
+      : 0
+  return { seconds, touches, scrolls, corrections }
+}
+
+/** Shows the four numbers, then resets for the next run. Does nothing when nothing was touched. */
+export function dmhTimingShowAndReset(): void {
+  if (startedAt === null) return
+  const report = dmhTimingReport()
+  dmhTimingReset()
+  Alert.alert(
+    "dmh-timing",
+    `secondes : ${report.seconds.toFixed(1)}\ntouches : ${report.touches}\n` +
+      `defilements : ${report.scrolls}\ncorrections : ${report.corrections}`,
+  )
+}
